/// A real inventory unit: either a whole-blood bag collected from a donor
/// (component = null) or a component split off from one via `sourceBagId`
/// (component = "Platelets" | "Plasma" | "Cryo" | "Red Cells" | "White Cells & Granulocytes").
/// Charge/payment fields are only populated for whole-blood bags — splitting
/// into components carries no separate charge in the demo product.
model BloodBag {
  id             String    @id @default(uuid()) @db.Uuid
  branchId       String    @db.Uuid
  donorId        String?   @db.Uuid
  sourceBagId    String?   @db.Uuid
  bagNo          String
  bloodGroup     String
  component      String?
  volume         String?
  unitType       String?
  lot            String?
  institution    String?
  donateDate     DateTime?
  chargeId       String?   @db.Uuid
  standardCharge Decimal?  @db.Decimal(14, 2)
  discountPct    Decimal   @default(0) @db.Decimal(5, 2)
  taxPct         Decimal   @default(0) @db.Decimal(5, 2)
  netAmount      Decimal?  @db.Decimal(14, 2)
  paidAmount     Decimal   @default(0) @db.Decimal(14, 2)
  paymentMode    String?
  note           String?
  status         String    @default("available") // available | issued
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  donor      BloodDonor? @relation(fields: [donorId], references: [id])
  sourceBag  BloodBag?   @relation("BagComponents", fields: [sourceBagId], references: [id])
  components BloodBag[]  @relation("BagComponents")
  charge     Charge?     @relation(fields: [chargeId], references: [id])
  issues     BloodIssue[]

  @@index([branchId, bloodGroup, component, status, deletedAt])
  @@map("blood_bag")
}

model BloodIssue {
  id            String   @id @default(uuid()) @db.Uuid
  branchId      String   @db.Uuid
  productId     String?  @db.Uuid
  bagId         String?  @db.Uuid
  donorId       String?  @db.Uuid
  patientId     String?  @db.Uuid
  invoiceId     String?  @db.Uuid
  type          String   @default("blood") // blood | component
  units         Int      @default(1)
  technician    String?
  note          String?
  bloodQty      String?
  issuedAt      DateTime @default(now())
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())

  product BloodProduct? @relation(fields: [productId], references: [id])
  bag     BloodBag?     @relation(fields: [bagId], references: [id])
  donor   BloodDonor?   @relation(fields: [donorId], references: [id])

  @@index([branchId, type, createdAt])
  @@map("blood_issue")
}

