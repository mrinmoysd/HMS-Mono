// Smart Hospital — Prisma schema
// Phase 0: Identity, RBAC, Branch, Audit, System. Later phases extend this file
// per docs/DATA_MODEL.md (each bounded context added in its phase).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Branch (multi-branch tenant dimension)
// ─────────────────────────────────────────────────────────────
model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  url       String?
  isHome    Boolean  @default(false)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  users     User[]
  auditLogs AuditLog[]

  @@map("branch")
}

// ─────────────────────────────────────────────────────────────
// RBAC: Role, Permission, RolePermission
// ─────────────────────────────────────────────────────────────
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique // e.g. super_admin, doctor
  label       String
  isSystem    Boolean  @default(true)
  isProtected Boolean  @default(false) // Super Admin — Admin cannot edit its matrix
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("role")
}

model Permission {
  id      String @id @default(uuid()) @db.Uuid
  module  String // ModuleKey from @smart-hospital/shared
  action  String // view | add | edit | delete
  label   String

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permission")
}

model RolePermission {
  id           String  @id @default(uuid()) @db.Uuid
  roleId       String  @db.Uuid
  permissionId String  @db.Uuid
  allowed      Boolean @default(true)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permission")
}

// ─────────────────────────────────────────────────────────────
// User (staff + patient accounts)
// ─────────────────────────────────────────────────────────────
enum UserType {
  staff
  patient
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  branchId     String   @db.Uuid
  roleId       String   @db.Uuid
  username     String   @unique
  email        String?  @unique
  phone        String?
  name         String
  passwordHash String
  type         UserType @default(staff)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  branch              Branch        @relation(fields: [branchId], references: [id])
  role                Role          @relation(fields: [roleId], references: [id])
  auditLogs           AuditLog[]
  doctorAppointments     Appointment[]  @relation("DoctorAppointments")
  consultantOpdVisits    OpdVisit[]     @relation("ConsultantOpdVisits")
  consultantIpdAdmissions IpdAdmission[] @relation("ConsultantIpdAdmissions")
  staffProfile           Staff?         @relation("StaffProfile")
  patientProfile         Patient?       @relation("PatientLogin")

  @@index([branchId, deletedAt])
  @@map("user")
}

// ─────────────────────────────────────────────────────────────
// Audit trail (FRD §2.28 — User Log / Audit Trail Report)
// ─────────────────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String?  @db.Uuid
  userId    String?  @db.Uuid
  action    String   // e.g. create, update, delete, login
  entity    String   // table / aggregate name
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  branch Branch? @relation(fields: [branchId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([branchId, createdAt])
  @@index([entity, entityId])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────
// System settings & languages (Setup → General / Languages)
// ─────────────────────────────────────────────────────────────
model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  scope     String   @default("global") // global | branch:<id>
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([scope, key])
  @@map("system_setting")
}

model Language {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique // en, hi, es, id, pt, ar, fr, tr, ru
  name     String
  isActive Boolean @default(true)
  isRtl    Boolean @default(false)

  @@map("language")
}

// ─────────────────────────────────────────────────────────────
// Phase 1 — Patient, Case, TPA
// ─────────────────────────────────────────────────────────────
enum Gender {
  male
  female
  other
}

model Tpa {
  id            String   @id @default(uuid()) @db.Uuid
  branchId      String   @db.Uuid
  name          String
  code          String?
  phone         String?
  address       String?
  contactPerson String?
  contactPhone  String?
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  patients Patient[]
  medicineBatchRates MedicineBatchTpaRate[]
  chargeSchedules ChargeSchedule[]

  @@index([branchId, deletedAt])
  @@map("tpa")
}

model Patient {
  id               String    @id @default(uuid()) @db.Uuid
  branchId         String    @db.Uuid
  patientNo        String
  name             String
  guardianName     String?
  gender           Gender?
  dob              DateTime?
  age              String
  bloodGroup       String?
  maritalStatus    String?
  photoUrl         String?
  phone            String?
  phoneNormalized  String?   // digits-only match key for shared-number lookup
  email            String?
  address          String?
  allergies        String?
  prevMedicalIssue String?
  remarks          String?
  tpaId            String?   @db.Uuid
  tpaIdNo          String?
  tpaValidity      DateTime?
  nationalId       String?
  alternateNo      String?
  userId           String?   @unique @db.Uuid // portal login account (if registered)
  isDisabled       Boolean   @default(false)
  isDeceased       Boolean   @default(false)
  customFields     Json      @default("{}")
  createdById      String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tpa            Tpa?            @relation(fields: [tpaId], references: [id])
  user           User?           @relation("PatientLogin", fields: [userId], references: [id])
  cases          PatientCase[]
  invoices       Invoice[]
  appointments   Appointment[]
  opdVisits      OpdVisit[]
  ipdAdmissions  IpdAdmission[]
  vitalReadings  VitalReading[]
  findingRecords FindingRecord[]
  symptomRecords SymptomRecord[]
  timelineEntries TimelineEntry[]
  labInvestigations LabInvestigation[]
  prescriptions  Prescription[]
  medicationDoses MedicationDose[]
  operationRecords OperationRecord[]
  liveConsultations LiveConsultation[]
  nurseNotes NurseNote[]
  consultantRegisters ConsultantRegister[]

  @@unique([branchId, patientNo])
  @@index([branchId, deletedAt, createdAt])
  @@index([branchId, name])
  @@index([branchId, phoneNormalized])
  @@map("patient")
}

model PatientCase {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  patientId String   @db.Uuid
  caseNo    String   // "Case ID" — links appointment/OPD/IPD/bills (later phases)
  type      String   @default("general") // appointment | opd | ipd | general
  status    String   @default("open")
  openedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  invoices      Invoice[]
  appointments  Appointment[]
  opdVisits     OpdVisit[]
  ipdAdmissions IpdAdmission[]

  @@unique([branchId, caseNo])
  @@index([patientId])
  @@map("patient_case")
}

/// Per-branch, per-prefix monotonic counter for human-readable IDs (patient no,
/// case no, bill no…). Prefixes are configurable in Setup → Prefix Setting.
model SequenceCounter {
  id       String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid
  key      String // e.g. "patient", "case"
  prefix   String @default("")
  next     Int    @default(1)

  @@unique([branchId, key])
  @@map("sequence_counter")
}

// ─────────────────────────────────────────────────────────────
// Phase 1 — Charge engine masters (Setup → Hospital Charges).
// Shared by every department's billing in later phases.
// ─────────────────────────────────────────────────────────────
model ChargeCategory {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  charges Charge[]

  @@index([branchId, deletedAt])
  @@map("charge_category")
}

model ChargeType {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  name      String
  modules   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  charges Charge[]

  @@index([branchId, deletedAt])
  @@map("charge_type")
}

model TaxCategory {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  name      String
  percent   Decimal  @default(0) @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  charges Charge[]

  @@index([branchId, deletedAt])
  @@map("tax_category")
}

model UnitType {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  charges Charge[]

  @@index([branchId, deletedAt])
  @@map("unit_type")
}

model Charge {
  id             String   @id @default(uuid()) @db.Uuid
  branchId       String   @db.Uuid
  name           String
  categoryId     String?  @db.Uuid
  typeId         String?  @db.Uuid
  unitId         String?  @db.Uuid
  taxCategoryId  String?  @db.Uuid
  standardCharge Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  category    ChargeCategory?   @relation(fields: [categoryId], references: [id])
  type        ChargeType?       @relation(fields: [typeId], references: [id])
  unit        UnitType?         @relation(fields: [unitId], references: [id])
  taxCategory TaxCategory?      @relation(fields: [taxCategoryId], references: [id])
  schedules   ChargeSchedule[]
  tests       DiagnosticTest[]
  bloodBags   BloodBag[]
  ambulanceCalls AmbulanceCall[]

  @@index([branchId, deletedAt, createdAt])
  @@map("charge")
}

/// Per-TPA price override for a Charge (Setup → Hospital Charges → Charges
/// Details → "Scheduled Charges For TPA"). Absence of a row = falls back to
/// Charge.standardCharge.
model ChargeSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  chargeId  String   @db.Uuid
  tpaId     String   @db.Uuid
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charge Charge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  tpa    Tpa    @relation(fields: [tpaId], references: [id], onDelete: Cascade)

  @@unique([chargeId, tpaId])
  @@index([branchId])
  @@map("charge_schedule")
}

// ─────────────────────────────────────────────────────────────
// Phase 1 — Custom Fields engine (Setup → Custom Fields).
// A definition attaches typed extra fields to one of 22 entities; values are
// stored inline on each entity's `customFields` JSONB column.
// ─────────────────────────────────────────────────────────────
model CustomField {
  id                 String   @id @default(uuid()) @db.Uuid
  branchId           String   @db.Uuid
  entity             String   // patient | appointment | opd | ipd | staff | ...
  label              String
  key                String   // stable machine key used in the JSONB map
  fieldType          String   // text | textarea | number | date | datetime | select | multiselect | checkbox | color | hyperlink
  options            Json     @default("[]") // for select/multiselect
  gridWidth          Int      @default(6) // 1..12
  required           Boolean  @default(false)
  visibleTable       Boolean  @default(false)
  visiblePrint       Boolean  @default(false)
  visibleReport      Boolean  @default(false)
  visiblePatientPanel Boolean @default(false)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  @@unique([branchId, entity, key])
  @@index([branchId, entity, deletedAt])
  @@map("custom_field")
}

// ─────────────────────────────────────────────────────────────
// Phase 1 — Print templates (Setup → Print Header/Footer).
// Drives certificates, ID cards, bills, discharge cards, etc.
// ─────────────────────────────────────────────────────────────
model PrintTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  branchId   String   @db.Uuid
  kind       String   // certificate | patient_id_card | staff_id_card | ...
  name       String
  headerHtml String?
  footerHtml String?
  bodyHtml   String   @default("")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  @@index([branchId, kind, deletedAt])
  @@map("print_template")
}

// ─────────────────────────────────────────────────────────────
// Phase 2 — Appointments, OPD, and the shared Invoice engine.
// ─────────────────────────────────────────────────────────────

/// The shared billing document. Every clinical department (OPD, IPD, pharmacy,
/// pathology, radiology, blood bank, ambulance) generates one of these via the
/// InvoiceService. `module` records which department produced it.
model Invoice {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  caseId      String?  @db.Uuid
  patientId   String   @db.Uuid
  billNo      String
  module      String   // opd | ipd | pharmacy | pathology | radiology | blood | ambulance | appointment
  billDate    DateTime @default(now())
  subtotal    Decimal  @default(0) @db.Decimal(14, 2)
  discount    Decimal  @default(0) @db.Decimal(14, 2)
  tax         Decimal  @default(0) @db.Decimal(14, 2)
  netAmount   Decimal  @default(0) @db.Decimal(14, 2)
  paid        Decimal  @default(0) @db.Decimal(14, 2)
  refund      Decimal  @default(0) @db.Decimal(14, 2)
  balance     Decimal  @default(0) @db.Decimal(14, 2)
  status      String   @default("unpaid") // unpaid | partial | paid
  tpaId       String?  @db.Uuid
  consultantId String? @db.Uuid
  referenceDoctor String?
  prescriptionNo  String?
  note        String?
  /// Free-text carried on Pathology/Radiology bills and shown as its own list
  /// column — distinct from the previous-reports history, which is derived.
  previousReportValue String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  patient   Patient       @relation(fields: [patientId], references: [id])
  case      PatientCase?  @relation(fields: [caseId], references: [id])
  items     InvoiceItem[]
  payments  Payment[]
  opdVisits OpdVisit[]    @relation("OpdInvoice")

  @@unique([branchId, billNo])
  @@index([branchId, module, deletedAt, createdAt])
  @@index([caseId])
  @@map("invoice")
}

model InvoiceItem {
  id             String  @id @default(uuid()) @db.Uuid
  invoiceId      String  @db.Uuid
  chargeId       String? @db.Uuid
  name           String
  standardCharge Decimal @default(0) @db.Decimal(14, 2)
  appliedCharge  Decimal @default(0) @db.Decimal(14, 2)
  qty            Int     @default(1)
  discountPct    Decimal @default(0) @db.Decimal(5, 2)
  taxPct         Decimal @default(0) @db.Decimal(5, 2)
  amount         Decimal @default(0) @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_item")
}

model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  amount      Decimal  @db.Decimal(14, 2)
  mode        String   @default("cash") // cash | card | upi | tpa | cheque
  reference   String?
  paidAt      DateTime @default(now())
  createdById String?  @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payment")
}

model Appointment {
  id               String   @id @default(uuid()) @db.Uuid
  branchId         String   @db.Uuid
  apptNo           String
  patientId        String   @db.Uuid
  caseId           String?  @db.Uuid
  doctorId         String   @db.Uuid
  apptDate         DateTime
  shift            String?
  slot             String?
  fees             Decimal  @default(0) @db.Decimal(14, 2)
  discountPct      Decimal  @default(0) @db.Decimal(5, 2)
  paid             Decimal  @default(0) @db.Decimal(14, 2)
  priority         String   @default("normal") // normal | urgent | vip
  source           String?
  paymentMode      String   @default("cash")
  liveConsult      Boolean  @default(false)
  status           String   @default("pending") // pending | approved | cancelled | completed
  message          String?
  alternateAddress String?
  // Surfaced on the Appointment Details screen alongside Payment Mode.
  paymentNote      String?
  transactionId    String?
  /// Per-branch running counter shown as "Appointment S.No." — distinct from
  /// apptNo, which is the formatted reference the patient is given.
  serialNo         Int?
  queueOrder       Int?
  createdById      String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  patient Patient     @relation(fields: [patientId], references: [id])
  case    PatientCase? @relation(fields: [caseId], references: [id])
  doctor  User        @relation("DoctorAppointments", fields: [doctorId], references: [id])

  @@unique([branchId, apptNo])
  @@index([branchId, apptDate, deletedAt])
  @@index([doctorId, apptDate])
  @@map("appointment")
}

model OpdVisit {
  id             String   @id @default(uuid()) @db.Uuid
  branchId       String   @db.Uuid
  opdNo          String
  patientId      String   @db.Uuid
  caseId         String?  @db.Uuid
  consultantId   String   @db.Uuid
  appointmentDate DateTime
  symptomType    String?
  symptoms       String?
  symptomDescription String?
  icd10Group     String?
  icd10Diagnosis String?
  knownAllergies String?
  previousMedicalIssue String?
  note           String?
  isAntenatal    Boolean  @default(false)
  casualty       Boolean  @default(false)
  oldPatient     Boolean  @default(false)
  applyTpa       Boolean  @default(false)
  liveConsult    Boolean  @default(false)
  reference      String?
  invoiceId      String?  @db.Uuid
  customFields   Json     @default("{}")
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  patient    Patient      @relation(fields: [patientId], references: [id])
  case       PatientCase? @relation(fields: [caseId], references: [id])
  consultant User         @relation("ConsultantOpdVisits", fields: [consultantId], references: [id])
  invoice    Invoice?     @relation("OpdInvoice", fields: [invoiceId], references: [id])

  @@unique([branchId, opdNo])
  @@index([branchId, appointmentDate, deletedAt])
  @@map("opd_visit")
}

// ─────────────────────────────────────────────────────────────
// Phase 3 — Beds & IPD (Setup → Bed; FRD §2.4).
// ─────────────────────────────────────────────────────────────
model Floor {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  bedGroups        BedGroup[]
  rosterAssignments RosterAssignment[]

  @@index([branchId, deletedAt])
  @@map("floor")
}

model BedType {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  beds Bed[]

  @@index([branchId, deletedAt])
  @@map("bed_type")
}

model BedGroup {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  floorId   String?  @db.Uuid
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  floor Floor? @relation(fields: [floorId], references: [id])
  beds  Bed[]

  @@index([branchId, deletedAt])
  @@map("bed_group")
}

model Bed {
  id         String   @id @default(uuid()) @db.Uuid
  branchId   String   @db.Uuid
  bedGroupId String   @db.Uuid
  bedTypeId  String?  @db.Uuid
  bedNo      String
  status     String   @default("available") // available | allotted
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  bedGroup   BedGroup       @relation(fields: [bedGroupId], references: [id])
  bedType    BedType?       @relation(fields: [bedTypeId], references: [id])
  admissions IpdAdmission[]

  @@index([branchId, deletedAt])
  @@index([branchId, status])
  @@map("bed")
}

model IpdAdmission {
  id            String    @id @default(uuid()) @db.Uuid
  branchId      String    @db.Uuid
  ipdNo         String
  patientId     String    @db.Uuid
  caseId        String?   @db.Uuid
  consultantId  String    @db.Uuid
  admissionDate DateTime
  bedId         String    @db.Uuid
  creditLimit   Decimal   @default(20000) @db.Decimal(14, 2)
  isAntenatal   Boolean   @default(false)
  casualty      Boolean   @default(false)
  oldPatient    Boolean   @default(false)
  applyTpa      Boolean   @default(false)
  reference     String?
  symptomType   String?
  symptoms      String?
  symptomDescription String?
  icd10Group    String?
  icd10Diagnosis String?
  knownAllergies String?
  previousMedicalIssue String?
  note          String?
  liveConsult   Boolean   @default(false)
  dischargeDate DateTime?
  status        String    @default("admitted") // admitted | discharged
  customFields  Json      @default("{}")
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  patient    Patient      @relation(fields: [patientId], references: [id])
  case       PatientCase? @relation(fields: [caseId], references: [id])
  consultant User         @relation("ConsultantIpdAdmissions", fields: [consultantId], references: [id])
  bed        Bed          @relation(fields: [bedId], references: [id])

  @@unique([branchId, ipdNo])
  @@index([branchId, status, deletedAt])
  @@map("ipd_admission")
}

// ─────────────────────────────────────────────────────────────
// Phase 4 — Diagnostics & Pharmacy. Bills are Invoices tagged by
// module (pharmacy | pathology | radiology | blood), generated via
// the shared InvoiceService.
// ─────────────────────────────────────────────────────────────
model MedicineCategory {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  medicines Medicine[]
  dosages   MedicineDosage[]

  @@index([branchId, deletedAt])
  @@map("medicine_category")
}

model PharmaCompany {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  medicines Medicine[]

  @@index([branchId, deletedAt])
  @@map("pharma_company")
}

model MedicineGroup {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  medicines Medicine[]

  @@index([branchId, deletedAt])
  @@map("medicine_group")
}

model PharmaUnit {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  medicines Medicine[]
  dosages   MedicineDosage[]

  @@index([branchId, deletedAt])
  @@map("pharma_unit")
}

model DosageInterval {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

