  branchId  String    @db.Uuid
  name      String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([branchId, deletedAt])
  @@map("appointment_priority")
}

/// A doctor's configuration for a shift: whether they work it (active) + the
/// consultation duration and charge that generate slots & set the fee (Setup → Slots).
model DoctorShift {
  id                          String    @id @default(uuid()) @db.Uuid
  branchId                    String    @db.Uuid
  doctorId                    String    @db.Uuid
  shiftId                     String    @db.Uuid
  active                      Boolean   @default(true)
  consultationDurationMinutes Int?
  chargeId                    String?   @db.Uuid
  amount                      Decimal   @default(0) @db.Decimal(14, 2)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  deletedAt                   DateTime?

  @@unique([doctorId, shiftId])
  @@index([branchId, deletedAt])
  @@map("doctor_shift")
}
